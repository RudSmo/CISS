using LinearAlgebra
using PyPlot

function vdot(S)
	sx = [0 1; 1 0.]
	sy = [0 -1im; 1im 0]
	sz = [1 0; 0 -1.]
	return S[1] * sx + S[2] * sy + S[3] * sz
end

L = 500;
Ls = 2*L
H = zeros(Ls,Ls);
l = 491
ls = 2*l
sS = 496
gLR = 12.0
gL = 10.0
gR = 1.0
eL = 0.0
eR = 0.0 

S = [0.0,0.0,1.0]
Jsd = 5.0
for i in 1:L-1
	if i == l
		k = gLR
	elseif i<l
		k = gL
	else
		k = gR
	end
	j = 2*i-1
	if i>l
		eps = eR
	else
		eps = eL
	end

	H[j,j] = eps
	H[j+1,j+1] = eps
        H[j,j+2] = k
        H[j+2,j] = k
	H[j+1,j+3] = k
	H[j+3,j+1] = k
	if i == sS
		vs = Jsd * vdot(S)	
		H[j,j] = vs[1,1]
		H[j,j+1] = vs[1,2]
		H[j+1,j] = vs[2,1]
		H[j+1,j+1] = vs[2,2]		
	end
end	

