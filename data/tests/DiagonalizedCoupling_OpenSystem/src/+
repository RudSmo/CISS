el,vl = eigen(HL)
er,vr = eigen(HR)

TH = zeros(Ls,Ls)
for i in 1:ls
	TH[i,i] = el[i]
end
for i in ls+1:Ls
	TH[i,i] = er[i-ls]
end
#display(TH)

Cl = H[1:ls,ls+1:Ls]
Cr = H[ls+1:Ls,1:ls]

#display(Cl)
#display(Cr)
#display(HR)
print(eigvals(HR))

Tl = vl*Cl*vr'
Tr = vr*Cr*vl'

for i in 1:ls
	for j in ls+1:Ls
		TH[i,j] = Tl[i,j-ls]
		TH[j,i] = Tr[j-ls,i]
	end
end

