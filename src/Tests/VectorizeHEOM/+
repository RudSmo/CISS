using LinearAlgebra
using PyPlot

function Heff(gL,gR,w0,tph,X)
	return [-1im*gL/2 -tph*sqrt(2*w0)*X; -tph*sqrt(2*w0)*X -1im*gR/2]
end

function Liouvillian(H,rho)
	return -1im * (H * rho - rho * H)
end


gL = 0.25
gR = 0.25
w0 = 0.05
tPh = 0.025
Id = Matrix(I,2,2)
ew = []

for X in -1:0.1:1

	H = Heff(gL,gR,w0,tPh,X)

	L = -1im*(kron(transpose(H),Id) - kron(Id,H))

	push!(ew,eigvals(L))
end

fig,ax = plt.subplots((2,1))

ax[1].plot(real.(eigvals))
ax[2].plot(imag.(eigvals))
plt.show()
