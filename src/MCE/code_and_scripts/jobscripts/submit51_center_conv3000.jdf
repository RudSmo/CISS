Executable   = /opt/rh/rh-python36/root/usr/bin/python3

Error        = runs/job.$(Cluster).$(Process).err
Log          = runs/job.$(Cluster).$(Process).log
Output       = runs/job.$(Cluster).$(Process).out
request_memory = 2048MB
request_disk=500MB
request_cpus = 26

#t0 omega gamma Lx Ly num_configs
#dt t_max initial_state[bare, dressed] psi_initial[local, eigen, CDW]
#calc_BO_electron_density[True, False] BO_nel_save_dist
#psi_state[2 ints y, x (local) or 1(eigen) or 0(CDW) inst]
#[name_of_subfolder, default=0])
queue 10 arguments from (
"mce_simulate.py 10 1 4 51 1 3000 0.01 20 bare local False 10 0 25 $(PROCESS)"
"mce_simulate.py 2.5 1 2.5 51 1 3000 0.01 20 bare local False 10 0 25 $(PROCESS)"
"mce_simulate.py 10 1 4 51 1 3000 0.01 20 dressed local False 10 0 25 $(PROCESS)"
"mce_simulate.py 2.5 1 2.5 51 1 3000 0.01 20 dressed local False 10 0 25 $(PROCESS)"
)

