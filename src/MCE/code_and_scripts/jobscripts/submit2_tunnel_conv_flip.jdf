Executable   = /opt/rh/rh-python36/root/usr/bin/python3

Error        = runs/job.$(Cluster).$(Process).err
Log          = runs/job.$(Cluster).$(Process).log
Output       = runs/job.$(Cluster).$(Process).out
request_memory = 1024MB
request_disk=500MB
request_cpus = 2

